{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:em-dashes": "! grep -rIl --exclude-dir=node_modules --exclude-dir=.next --include='*.ts' --include='*.tsx' --include='*.md' --include='*.css' --include='*.json' $'\\u2014' src INVARIANTS.md AGENTS.md 2>/dev/null",
    "test:integrity": "tsx --tsconfig tsconfig.json evals/integrity.test.ts",
    "test:draft-math": "tsx --tsconfig tsconfig.json evals/draft-math.test.ts",
    "test:anti-patterns": "tsx --tsconfig tsconfig.json evals/anti-patterns.test.ts",
    "test:rerank": "tsx --tsconfig tsconfig.json evals/rerank.test.ts",
    "test:swot": "tsx --tsconfig tsconfig.json evals/swot.test.ts",
    "test:future-stash": "tsx --tsconfig tsconfig.json evals/future-stash.test.ts",
    "test:evaluation": "tsx --tsconfig tsconfig.json evals/evaluation.test.ts",
    "test": "npm run test:integrity && npm run test:draft-math && npm run test:anti-patterns && npm run test:rerank && npm run test:swot && npm run test:future-stash && npm run test:evaluation && npm run check:em-dashes"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@next/third-parties": "^16.2.4",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
